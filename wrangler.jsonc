{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lab-gaato-net",
	"compatibility_date": "2026-08-27",
	"workers_dev": false,
	"assets": {
		"directory": "./build",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}
